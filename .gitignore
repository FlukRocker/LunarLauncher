node_modules/
dist/
src-tauri/target/
src-tauri/gen/
/.vs/
/.vscode/
/logs/

# Updater signing keys. The private key must never enter the repository —
# anyone holding it can sign an update every installed launcher will trust
# and execute. It lives outside the tree; CI signs from a secret.
*.key
*.key.pub

# Build-time configuration. `.env.example` is the documented template; the
# real files carry per-customer endpoints and are never committed.
.env
.env.local
.env.*.local
# Generated from the environment by scripts/brand.mjs on every branded build.
src-tauri/tauri.brand.json
installer/payload.zip
