# Build-time and runtime configuration.
#
# Copy to `.env` (git-ignored) and edit. `.env.local` is read first, so a
# shared `.env` can be committed to a private deployment repo while personal
# overrides stay local. A real environment variable always beats both.
#
#   .env / .env.local  ──►  build.rs   ──►  baked into the binary
#                      ──►  brand.mjs  ──►  tauri config patch
#                      ──►  vite       ──►  frontend title
#
# In a *debug* build these are also read at startup from the working
# directory, which is what makes `npm run app:dev` work without exporting
# anything. A release build ignores a stray `.env` unless LUNAR_ENV_FILE
# points at one explicitly — otherwise a dropped file could repoint a shipped
# launcher at another distribution index.

# ---------------------------------------------------------------------------
# Where the launcher gets its content
# ---------------------------------------------------------------------------

# The distribution index. An http(s) URL, a file:// URL, or a plain path.
# `dev-distribution.json` is an unmodded 1.20.1 server that exercises the full
# launch path — useful because hermes-mc.net no longer resolves.
#LUNAR_DISTRO_URL=./dev-distribution.json

# Yggdrasil endpoint for Mojang-account login. Mojang's own no longer
# resolves, so a custom one is normally required.
#LUNAR_AUTH_SERVER=https://auth.example.test

# Azure application (client) id for Microsoft sign-in. A fork must register
# its own; see docs/MicrosoftAuth.md. Public client — there is no secret, and
# none should ever be added here.
#LUNAR_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# ---------------------------------------------------------------------------
# Branding — read by scripts/brand.mjs, used with `npm run app:build:branded`
# ---------------------------------------------------------------------------

# Product name: the window title, the installer name, the install directory.
#LUNAR_BRAND_NAME=Acme Launcher

# Bundle identifier, reverse-DNS. This picks the config directory, so changing
# it gives the build its own accounts and settings rather than inheriting an
# existing install's.
#LUNAR_APP_IDENTIFIER=net.acme.launcher

# Installer version, strictly x.y.z — NSIS and MSI reject a "v" prefix or a
# "-beta" suffix.
#LUNAR_VERSION=2.2.1

# Window background, #rrggbb. Shown before the frontend paints, so a mismatch
# with the theme reads as a flash on startup.
#LUNAR_WINDOW_BG=#171614

# Directory holding 32x32.png, 128x128.png, 128x128@2x.png, icon.icns and
# icon.ico. Relative to the repo root.
#LUNAR_ICON_DIR=src-tauri/icons

# ---------------------------------------------------------------------------
# Updates
# ---------------------------------------------------------------------------

# Must contain {{target}} and {{current_version}}, or every platform is served
# the same file. Setting this enables the updater.
#LUNAR_UPDATER_ENDPOINT=https://updates.example.test/{{target}}/{{current_version}}

# Minisign public key matching the private key used to sign releases. Required
# whenever the endpoint is set: without it the launcher installs whatever that
# endpoint returns.
#
# The PRIVATE key is passed to the build as TAURI_SIGNING_PRIVATE_KEY and must
# never appear in this file or any other file in the repository. Anyone holding
# it can sign an update every installed launcher will trust and execute.
#LUNAR_UPDATER_PUBKEY=
